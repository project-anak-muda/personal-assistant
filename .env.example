# ─── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Gemini (Google AI Studio — https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash-exp

# Local / OpenAI-compatible LLM. Only needed if you run the "local" provider
# (this is the built-in default in models/llm.py). Leave as-is if you use Gemini.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_MODEL=qwen2.5

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Spreadsheet ID — the <ID> part of https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# Path to the service-account JSON.
#   Local: ./service_account.json
#   Docker: overridden to /mnt/service_account.json by docker-compose.yml
GOOGLE_SA_PATH=./service_account.json

# Worksheet (tab) names — only change these if you renamed the tabs in your Sheet.
SPENDING_WORKSHEET=Spending
BANK_INFO_WORKSHEET=BankInfo
WHITELIST_USERS_WORKSHEET=WhitelistUsername
BUDGET_WORKSHEET=Budget

# Warn when spending reaches this fraction of the monthly budget (0.0–1.0).
BUDGET_WARN_THRESHOLD=0.8
