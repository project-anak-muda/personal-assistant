# ─── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Shared secret for the webhook transport (webhook_app.py). Telegram echoes it
# back in the X-Telegram-Bot-Api-Secret-Token header on every delivery — it is
# the only thing stopping a stranger who finds the public URL from driving the
# bot. Required for webhook mode; unused for long polling.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Which backend get_model() uses: "local" or "google".
# Cloud Run has no local LLM to reach, so the deployed service must set this to
# "google". Leave as "local" for host/docker runs against your own LLM server.
LLM_PROVIDER=local

# Gemini (Google AI Studio — https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash-exp

# Local / OpenAI-compatible LLM. Only needed if you run the "local" provider
# (this is the built-in default in models/llm.py). Leave as-is if you use Gemini.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_MODEL=qwen2.5

# ─── Conversation state (LangGraph checkpointer) ──────────────────────────────
# Postgres connection string. Use Neon's POOLED endpoint here (host contains
# "-pooler"), because a scale-to-zero container opens a fresh connection on
# every cold start.
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# Leave unset to fall back to an in-memory checkpointer. That works locally but
# loses all conversation state on restart — never leave it unset in production.
DATABASE_URL=

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Spreadsheet ID — the <ID> part of https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# Path to the service-account JSON.
#   Local: ./service_account.json
#   Docker: overridden to /mnt/service_account.json by docker-compose.yml
GOOGLE_SA_PATH=./service_account.json

# Worksheet (tab) names — only change these if you renamed the tabs in your Sheet.
SPENDING_WORKSHEET=Spending
BANK_INFO_WORKSHEET=BankInfo
WHITELIST_USERS_WORKSHEET=WhitelistUsername
BUDGET_WORKSHEET=Budget

# Warn when spending reaches this fraction of the monthly budget (0.0–1.0).
BUDGET_WARN_THRESHOLD=0.8
